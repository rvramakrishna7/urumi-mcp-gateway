{
  "name": "gateway",
  "version": "0.1.0",
  "description": "Team MCP gateway backend: upstream registry, tool aggregation and routing, API keys and audit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test",
    "test:db": "sh scripts/test-db.sh",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "dev": "node --watch src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
